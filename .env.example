DATABASE_URL="postgresql://studyhub:studyhub@localhost:5432/studyhub?schema=public"
ADMINER_PORT=8081
# Gere com: npx auth secret
AUTH_SECRET="replace-with-at-least-32-random-bytes"

# Tutor inteligente — somente backend. Não use NEXT_PUBLIC_.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1500
AI_REQUESTS_PER_DAY=20
AI_TOKENS_PER_DAY=50000
AI_MAX_CONCURRENT_PER_USER=1
AI_CONTEXT_MESSAGES=8
AI_RETRIEVAL_LIMIT=5
