generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  CURATOR
  ADMIN
}

enum ResourceVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum ObjectiveStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum StudyAreaStatus {
  ACTIVE
  ARCHIVED
}

enum ObjectiveMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum CatalogStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ExaminationStatus {
  PLANNED
  AUTHORIZED
  BOARD_DEFINED
  NOTICE_PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  EXAM_SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NoticeDocumentType {
  OPENING
  AMENDMENT
  RECTIFICATION
  ANNOUNCEMENT
  OTHER
}

enum MaterialKind {
  NOTE
  ARTICLE
  BOOK
  VIDEO
  FILE
  LINK
  AI_GENERATED
}

enum ContentFormat {
  MARKDOWN
  STRUCTURED_CONTENT
}

enum LearningProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ExerciseMode {
  PRACTICE
  EXAM
}

enum ExerciseListStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ContentSourceType {
  OFFICIAL_DOCUMENT
  LEGISLATION
  ORIGINAL_CONTENT
  LICENSED_MATERIAL
  USER_PROVIDED
  OTHER
}

enum ContentProvenance {
  OFFICIAL
  AUTHORED
  LICENSED
  AI_GENERATED
}

enum QuestionKind {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum TaskOrigin {
  GENERATED
  MANUAL
  RESCHEDULED
}

enum StudyPlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum PlanningStrategy {
  BALANCED
  PRIORITY_BASED
  DEADLINE_BASED
}

enum PlanTopicStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ActivityType {
  THEORY
  PRACTICE
  REVIEW
  SIMULATION
  CUSTOM
}

enum PlanningPreviewKind {
  GENERATE
  REPLAN
}

enum PlanningPreviewStatus {
  PENDING
  APPLIED
  EXPIRED
  CANCELLED
}

enum SessionKind {
  THEORY
  PRACTICE
  REVIEW
  MOCK_EXAM
}

enum ReviewScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ErrorNotebookStatus {
  OPEN
  REVIEWING
  RESOLVED
  ARCHIVED
}

enum MockExamStatus {
  DRAFT
  READY
  ARCHIVED
}

enum MockExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  FINISHED
  EXPIRED
  ABANDONED
}

enum ScoringStrategy {
  SIMPLE
  WEIGHTED_BY_SECTION
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          SystemRole @default(USER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts         Account[]
  sessions         AuthSession[]
  studyAreas       StudyArea[]
  ownedObjectives  Objective[]          @relation("ObjectiveOwner")
  objectiveMembers ObjectiveMember[]
  materials        Material[]           @relation("MaterialAuthor")
  questions        Question[]           @relation("QuestionAuthor")
  studyPlans       StudyPlan[]
  studySessions    StudySession[]
  attempts         QuestionAttempt[]
  reviewSchedules  ReviewSchedule[]
  reviewAttempts   ReviewAttempt[]
  errorEntries     ErrorNotebookEntry[]
  mockExams        MockExam[]
  mockExamAttempts MockExamAttempt[]
  learningProgress LearningProgress[]
  materialVersions MaterialVersion[]    @relation("MaterialVersionCreator")
  questionVersions QuestionVersion[]    @relation("QuestionVersionCreator")
  exerciseLists    ExerciseList[]
  questionSessions QuestionSession[]
}

model Account {
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model StudyArea {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @db.Uuid
  name        String          @db.VarChar(120)
  description String?         @db.Text
  color       String?         @db.VarChar(20)
  icon        String?         @db.VarChar(40)
  status      StudyAreaStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  objectives  Objective[]

  @@unique([ownerId, name])
  @@index([ownerId, status])
  @@index([ownerId, archivedAt])
}

model ObjectiveType {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String?     @db.Uuid
  key         String      @db.VarChar(50)
  name        String      @db.VarChar(80)
  description String?     @db.Text
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  objectives  Objective[]

  @@unique([ownerId, key])
}

model Objective {
  id            String                    @id @default(uuid()) @db.Uuid
  ownerId       String                    @db.Uuid
  studyAreaId   String?                   @db.Uuid
  typeId        String                    @db.Uuid
  name          String                    @db.VarChar(160)
  description   String?                   @db.Text
  priority      Int                       @default(3) @db.SmallInt
  deadline      DateTime?                 @db.Date
  status        ObjectiveStatus           @default(ACTIVE)
  archivedAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  owner         User                      @relation("ObjectiveOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  studyArea     StudyArea?                @relation(fields: [studyAreaId], references: [id], onDelete: SetNull)
  type          ObjectiveType             @relation(fields: [typeId], references: [id], onDelete: Restrict)
  members       ObjectiveMember[]
  notices       ObjectiveNotice[]
  subjects      ObjectiveSubject[]
  plans         StudyPlanObjective[]
  sessions      StudySession[]
  examinationId String?                   @db.Uuid
  examination   Examination?              @relation(fields: [examinationId], references: [id], onDelete: SetNull)
  positions     ObjectivePosition[]
  planTopics    StudyPlanTopicObjective[]
  mockExams     MockExam[]

  @@index([ownerId, status])
  @@index([ownerId, studyAreaId, status])
  @@index([deadline])
  @@index([ownerId, examinationId])
}

model ObjectiveMember {
  objectiveId String              @db.Uuid
  userId      String              @db.Uuid
  role        ObjectiveMemberRole @default(VIEWER)
  createdAt   DateTime            @default(now())
  objective   Objective           @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([objectiveId, userId])
  @@index([userId])
}

model Organization {
  id                   String         @id @default(uuid()) @db.Uuid
  parentOrganizationId String?        @db.Uuid
  name                 String         @db.VarChar(160)
  normalizedName       String         @db.VarChar(180)
  acronym              String?        @db.VarChar(30)
  description          String?        @db.Text
  website              String?
  country              String         @default("BR") @db.Char(2)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  parent               Organization?  @relation("OrganizationTree", fields: [parentOrganizationId], references: [id], onDelete: Restrict)
  children             Organization[] @relation("OrganizationTree")
  examinations         Examination[]

  @@unique([country, normalizedName])
  @@index([parentOrganizationId])
}

model ExamBoard {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar(160)
  normalizedName String        @db.VarChar(180)
  acronym        String?       @db.VarChar(30)
  website        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  examinations   Examination[]
  questions      Question[]

  @@unique([normalizedName])
}

model Examination {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @db.Uuid
  examBoardId         String?           @db.Uuid
  title               String            @map("name") @db.VarChar(180)
  description         String?           @db.Text
  year                Int?
  status              ExaminationStatus @default(PLANNED)
  publicationStatus   CatalogStatus     @default(DRAFT)
  registrationStartAt DateTime?
  registrationEndAt   DateTime?
  examDate            DateTime?
  officialUrl         String?
  sourceReference     String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  examBoard           ExamBoard?        @relation(fields: [examBoardId], references: [id], onDelete: SetNull)
  positions           Position[]
  notices             Notice[]
  syllabuses          Syllabus[]
  objectives          Objective[]
  questions           Question[]
  mockExams           MockExam[]

  @@unique([organizationId, title, year])
  @@index([publicationStatus, status, year])
  @@index([examBoardId])
  @@map("Exam")
}

model Position {
  id              String              @id @default(uuid()) @db.Uuid
  examinationId   String              @map("examId") @db.Uuid
  title           String              @map("name") @db.VarChar(160)
  description     String?             @db.Text
  educationLevel  String?             @db.VarChar(120)
  requirements    String?             @db.Text
  vacancies       Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  examination     Examination         @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  specializations Specialization[]
  noticePositions NoticePosition[]
  syllabuses      Syllabus[]
  objectives      ObjectivePosition[]
  questions       Question[]
  mockExams       MockExam[]

  @@unique([examinationId, title])
  @@map("ExamPosition")
}

model Specialization {
  id          String              @id @default(uuid()) @db.Uuid
  positionId  String              @db.Uuid
  name        String              @db.VarChar(160)
  description String?             @db.Text
  vacancies   Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  position    Position            @relation(fields: [positionId], references: [id], onDelete: Cascade)
  syllabuses  Syllabus[]
  objectives  ObjectivePosition[]

  @@unique([positionId, name])
}

model Notice {
  id               String             @id @default(uuid()) @db.Uuid
  examinationId    String             @map("examId") @db.Uuid
  originalNoticeId String?            @db.Uuid
  title            String             @db.VarChar(200)
  noticeNumber     String?            @db.VarChar(80)
  documentType     NoticeDocumentType @default(OTHER)
  status           CatalogStatus      @default(DRAFT)
  publicationDate  DateTime?          @map("publishedAt")
  officialUrl      String?
  filePath         String?
  sourceReference  String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  examination      Examination        @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  originalNotice   Notice?            @relation("NoticeCorrections", fields: [originalNoticeId], references: [id], onDelete: Restrict)
  corrections      Notice[]           @relation("NoticeCorrections")
  versions         NoticeVersion[]
  positions        NoticePosition[]
  objectives       ObjectiveNotice[]
  syllabuses       Syllabus[]

  @@index([examinationId, status, publicationDate])
  @@index([originalNoticeId])
}

model NoticeVersion {
  id                String              @id @default(uuid()) @db.Uuid
  noticeId          String              @db.Uuid
  version           Int
  status            CatalogStatus       @default(DRAFT)
  sourceUrl         String?
  sourceFileKey     String?
  extractionData    Json?
  reviewerId        String?             @db.Uuid
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  documentUrl       String?
  contentHash       String?             @db.VarChar(128)
  publishedAt       DateTime?
  changeDescription String?             @db.Text
  notice            Notice              @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  subjectRules      NoticeSubjectRule[]

  @@unique([noticeId, version])
  @@index([status])
}

model NoticePosition {
  noticeId   String   @db.Uuid
  positionId String   @db.Uuid
  vacancies  Int?
  notice     Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  position   Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@id([noticeId, positionId])
}

model ObjectivePosition {
  id               String          @id @default(uuid()) @db.Uuid
  objectiveId      String          @db.Uuid
  positionId       String          @db.Uuid
  specializationId String?         @db.Uuid
  createdAt        DateTime        @default(now())
  objective        Objective       @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  position         Position        @relation(fields: [positionId], references: [id], onDelete: Restrict)
  specialization   Specialization? @relation(fields: [specializationId], references: [id], onDelete: Restrict)

  @@unique([objectiveId, positionId, specializationId])
  @@index([positionId])
  @@index([specializationId])
}

model ObjectiveNotice {
  objectiveId String    @db.Uuid
  noticeId    String    @db.Uuid
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  notice      Notice    @relation(fields: [noticeId], references: [id], onDelete: Restrict)

  @@id([objectiveId, noticeId])
}

model Subject {
  id               String              @id @default(uuid()) @db.Uuid
  name             String              @db.VarChar(160)
  slug             String              @unique @db.VarChar(180)
  description      String?             @db.Text
  status           CatalogStatus       @default(DRAFT)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  topics           Topic[]
  objectives       ObjectiveSubject[]
  noticeRules      NoticeSubjectRule[]
  syllabusItems    SyllabusItem[]
  mockExamSections MockExamSection[]
}

model Topic {
  id              String               @id @default(uuid()) @db.Uuid
  subjectId       String               @db.Uuid
  parentId        String?              @db.Uuid
  name            String               @db.VarChar(200)
  slug            String               @db.VarChar(220)
  description     String?              @db.Text
  position        Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  subject         Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent          Topic?               @relation("TopicTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Topic[]              @relation("TopicTree")
  materials       MaterialTopic[]
  questions       QuestionTopic[]
  noticeRules     NoticeSubjectRule[]
  planTasks       PlanTask[]
  planTopics      StudyPlanTopic[]
  sessions        StudySession[]
  reviewSchedules ReviewSchedule[]
  errors          ErrorNotebookEntry[]
  syllabusItems   SyllabusItem[]

  @@unique([subjectId, parentId, slug])
  @@index([subjectId, parentId, position])
}

model Syllabus {
  id               String          @id @default(uuid()) @db.Uuid
  examinationId    String          @db.Uuid
  noticeId         String?         @db.Uuid
  positionId       String?         @db.Uuid
  specializationId String?         @db.Uuid
  title            String          @db.VarChar(200)
  status           CatalogStatus   @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  examination      Examination     @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  notice           Notice?         @relation(fields: [noticeId], references: [id], onDelete: SetNull)
  position         Position?       @relation(fields: [positionId], references: [id], onDelete: Restrict)
  specialization   Specialization? @relation(fields: [specializationId], references: [id], onDelete: Restrict)
  items            SyllabusItem[]

  @@index([examinationId, status])
  @@index([positionId, specializationId])
}

model SyllabusItem {
  id                String           @id @default(uuid()) @db.Uuid
  syllabusId        String           @db.Uuid
  parentItemId      String?          @db.Uuid
  subjectId         String?          @db.Uuid
  topicId           String?          @db.Uuid
  title             String           @db.VarChar(300)
  description       String?          @db.Text
  order             Int              @default(0)
  weight            Decimal?         @db.Decimal(8, 3)
  numberOfQuestions Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  syllabus          Syllabus         @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  parent            SyllabusItem?    @relation("SyllabusTree", fields: [parentItemId], references: [id], onDelete: Restrict)
  children          SyllabusItem[]   @relation("SyllabusTree")
  subject           Subject?         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic             Topic?           @relation(fields: [topicId], references: [id], onDelete: Restrict)
  planTopics        StudyPlanTopic[]

  @@unique([syllabusId, parentItemId, order])
  @@index([syllabusId, parentItemId, order])
  @@index([subjectId, topicId])
}

model ObjectiveSubject {
  objectiveId String    @db.Uuid
  subjectId   String    @db.Uuid
  weight      Decimal   @default(1) @db.Decimal(8, 3)
  priority    Int       @default(3) @db.SmallInt
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([objectiveId, subjectId])
}

model NoticeSubjectRule {
  id              String        @id @default(uuid()) @db.Uuid
  noticeVersionId String        @db.Uuid
  subjectId       String        @db.Uuid
  topicId         String?       @db.Uuid
  weight          Decimal?      @db.Decimal(8, 3)
  questionCount   Int?
  requirementText String?       @db.Text
  noticeVersion   NoticeVersion @relation(fields: [noticeVersionId], references: [id], onDelete: Cascade)
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic           Topic?        @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([noticeVersionId, subjectId, topicId])
}

model Material {
  id               String             @id @default(uuid()) @db.Uuid
  authorId         String             @db.Uuid
  title            String             @db.VarChar(220)
  slug             String             @unique @db.VarChar(240)
  summary          String?            @db.Text
  kind             MaterialKind
  contentFormat    ContentFormat      @default(MARKDOWN)
  provenance       ContentProvenance
  visibility       ResourceVisibility @default(PRIVATE)
  status           CatalogStatus      @default(DRAFT)
  license          String?            @db.VarChar(120)
  sourceUrl        String?
  currentVersion   Int                @default(1)
  estimatedMinutes Int?
  publishedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  author           User               @relation("MaterialAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  versions         MaterialVersion[]
  topics           MaterialTopic[]
  sources          ContentSource[]
  progress         LearningProgress[]
  tasks            PlanTask[]

  @@index([authorId, visibility, status])
}

model MaterialVersion {
  id                String   @id @default(uuid()) @db.Uuid
  materialId        String   @db.Uuid
  version           Int
  content           String?  @db.Text
  fileKey           String?
  mimeType          String?  @db.VarChar(120)
  checksum          String?  @db.VarChar(128)
  aiGenerated       Boolean  @default(false)
  changeDescription String?  @db.Text
  createdById       String   @db.Uuid
  createdAt         DateTime @default(now())
  material          Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdBy         User     @relation("MaterialVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([materialId, version])
}

model MaterialTopic {
  materialId String   @db.Uuid
  topicId    String   @db.Uuid
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([materialId, topicId])
}

model ContentSource {
  id              String            @id @default(uuid()) @db.Uuid
  materialId      String?           @db.Uuid
  title           String            @db.VarChar(220)
  sourceType      ContentSourceType
  sourceUrl       String?
  author          String?           @db.VarChar(180)
  publicationDate DateTime?         @db.Date
  accessedAt      DateTime?
  description     String?           @db.Text
  createdAt       DateTime          @default(now())
  material        Material?         @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([materialId])
}

model LearningProgress {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @db.Uuid
  materialId         String                 @db.Uuid
  status             LearningProgressStatus @default(NOT_STARTED)
  progressPercentage Int                    @default(0) @db.SmallInt
  lastPosition       String?                @db.VarChar(500)
  startedAt          DateTime?
  completedAt        DateTime?
  updatedAt          DateTime               @updatedAt
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  material           Material               @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([userId, materialId])
  @@index([userId, status, updatedAt])
}

model Question {
  id             String                 @id @default(uuid()) @db.Uuid
  authorId       String?                @db.Uuid
  boardId        String?                @db.Uuid
  examinationId  String?                @db.Uuid
  positionId     String?                @db.Uuid
  kind           QuestionKind
  difficulty     QuestionDifficulty     @default(MEDIUM)
  provenance     ContentProvenance
  visibility     ResourceVisibility     @default(PRIVATE)
  status         CatalogStatus          @default(DRAFT)
  statement      String                 @db.Text
  explanation    String?                @db.Text
  year           Int?
  sourceLabel    String?                @db.VarChar(220)
  sourceUrl      String?
  copyrightNote  String?                @db.Text
  aiModel        String?                @db.VarChar(100)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  publishedAt    DateTime?
  currentVersion Int                    @default(0)
  author         User?                  @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  board          ExamBoard?             @relation(fields: [boardId], references: [id], onDelete: SetNull)
  examination    Examination?           @relation(fields: [examinationId], references: [id], onDelete: SetNull)
  position       Position?              @relation(fields: [positionId], references: [id], onDelete: SetNull)
  options        QuestionOption[]
  topics         QuestionTopic[]
  attempts       QuestionAttempt[]
  errors         ErrorNotebookEntry[]
  versions       QuestionVersion[]
  listItems      ExerciseListQuestion[]
  sessionItems   QuestionSessionItem[]

  @@index([authorId, visibility, status])
  @@index([boardId, year])
  @@index([difficulty, status])
  @@index([examinationId, positionId])
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  label      String   @db.VarChar(10)
  text       String   @db.Text
  isCorrect  Boolean  @default(false)
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
  @@unique([questionId, position])
}

model QuestionVersion {
  id           String                @id @default(uuid()) @db.Uuid
  questionId   String                @db.Uuid
  version      Int
  kind         QuestionKind
  statement    String                @db.Text
  explanation  String?               @db.Text
  options      Json
  createdById  String                @db.Uuid
  createdAt    DateTime              @default(now())
  question     Question              @relation(fields: [questionId], references: [id], onDelete: Restrict)
  createdBy    User                  @relation("QuestionVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attempts     QuestionAttempt[]
  sessionItems QuestionSessionItem[]

  @@unique([questionId, version])
  @@index([questionId, createdAt])
}

model QuestionTopic {
  questionId String   @db.Uuid
  topicId    String   @db.Uuid
  isPrimary  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([questionId, topicId])
}

model StudyPlan {
  id                  String               @id @default(uuid()) @db.Uuid
  ownerId             String               @db.Uuid
  name                String               @db.VarChar(160)
  description         String?              @db.Text
  status              StudyPlanStatus      @default(DRAFT)
  startDate           DateTime             @db.Date
  endDate             DateTime?            @db.Date
  dailyTargetMinutes  Int?
  weeklyTargetMinutes Int?
  planningStrategy    PlanningStrategy     @default(BALANCED)
  timezone            String               @default("America/Bahia") @db.VarChar(80)
  version             Int                  @default(1)
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  objectives          StudyPlanObjective[]
  availability        StudyAvailability[]
  topics              StudyPlanTopic[]
  tasks               PlanTask[]
  sessions            StudySession[]
  revisions           StudyPlanRevision[]
  previews            PlanningPreview[]

  @@index([ownerId, status, createdAt])
}

model StudyPlanObjective {
  planId         String    @db.Uuid
  objectiveId    String    @db.Uuid
  priorityWeight Decimal   @default(1) @db.Decimal(8, 3)
  createdAt      DateTime  @default(now())
  plan           StudyPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  objective      Objective @relation(fields: [objectiveId], references: [id], onDelete: Restrict)

  @@id([planId, objectiveId])
}

model StudyAvailability {
  id          String    @id @default(uuid()) @db.Uuid
  planId      String    @db.Uuid
  dayOfWeek   Int       @db.SmallInt
  startMinute Int       @db.SmallInt
  endMinute   Int       @db.SmallInt
  isEnabled   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  plan        StudyPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, dayOfWeek, startMinute])
}

model StudyPlanTopic {
  id               String                    @id @default(uuid()) @db.Uuid
  planId           String                    @db.Uuid
  topicId          String?                   @db.Uuid
  syllabusItemId   String?                   @db.Uuid
  customTitle      String?                   @db.VarChar(200)
  customSubject    String?                   @db.VarChar(160)
  estimatedMinutes Int
  priority         Int                       @default(3) @db.SmallInt
  status           PlanTopicStatus           @default(PENDING)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  plan             StudyPlan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  topic            Topic?                    @relation(fields: [topicId], references: [id], onDelete: Restrict)
  syllabusItem     SyllabusItem?             @relation(fields: [syllabusItemId], references: [id], onDelete: Restrict)
  objectives       StudyPlanTopicObjective[]
  tasks            PlanTask[]

  @@unique([planId, topicId])
  @@unique([planId, syllabusItemId])
  @@index([planId, status, priority])
}

model StudyPlanTopicObjective {
  studyPlanTopicId String         @db.Uuid
  objectiveId      String         @db.Uuid
  studyPlanTopic   StudyPlanTopic @relation(fields: [studyPlanTopicId], references: [id], onDelete: Restrict)
  objective        Objective      @relation(fields: [objectiveId], references: [id], onDelete: Restrict)

  @@id([studyPlanTopicId, objectiveId])
  @@index([objectiveId])
}

model PlanTask {
  id               String            @id @default(uuid()) @db.Uuid
  planId           String            @db.Uuid
  topicId          String?           @db.Uuid
  studyPlanTopicId String?           @db.Uuid
  title            String            @db.VarChar(200)
  description      String?           @db.Text
  activityType     ActivityType      @default(THEORY)
  scheduledDate    DateTime          @db.Date
  scheduledStart   DateTime
  plannedEndAt     DateTime?
  scheduledMinutes Int
  status           TaskStatus        @default(PLANNED)
  origin           TaskOrigin        @default(GENERATED)
  manualLock       Boolean           @default(false)
  generationKey    String?           @db.VarChar(120)
  supersedesId     String?           @db.Uuid
  materialId       String?           @db.Uuid
  exerciseListId   String?           @db.Uuid
  reviewScheduleId String?           @db.Uuid
  mockExamId       String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  completedAt      DateTime?
  plan             StudyPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  topic            Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  studyPlanTopic   StudyPlanTopic?   @relation(fields: [studyPlanTopicId], references: [id], onDelete: SetNull)
  supersedes       PlanTask?         @relation("TaskReschedule", fields: [supersedesId], references: [id], onDelete: SetNull)
  rescheduledAs    PlanTask[]        @relation("TaskReschedule")
  sessions         StudySession[]
  material         Material?         @relation(fields: [materialId], references: [id], onDelete: SetNull)
  exerciseList     ExerciseList?     @relation(fields: [exerciseListId], references: [id], onDelete: SetNull)
  reviewSchedule   ReviewSchedule?   @relation(fields: [reviewScheduleId], references: [id], onDelete: SetNull)
  mockExam         MockExam?         @relation(fields: [mockExamId], references: [id], onDelete: SetNull)
  questionSessions QuestionSession[]

  @@unique([planId, generationKey])
  @@index([planId, scheduledDate, status])
}

model StudySession {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  planId           String?           @db.Uuid
  taskId           String?           @db.Uuid
  objectiveId      String?           @db.Uuid
  topicId          String?           @db.Uuid
  kind             SessionKind
  startedAt        DateTime
  endedAt          DateTime?
  durationSeconds  Int?
  notes            String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             StudyPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  task             PlanTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  objective        Objective?        @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  topic            Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attempts         QuestionAttempt[]
  questionSessions QuestionSession[]

  @@index([userId, startedAt])
  @@index([objectiveId, topicId])
}

model StudyPlanRevision {
  id             String    @id @default(uuid()) @db.Uuid
  planId         String    @db.Uuid
  revisionNumber Int
  reason         String    @db.VarChar(200)
  changeSummary  Json
  createdAt      DateTime  @default(now())
  plan           StudyPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, revisionNumber])
}

model PlanningPreview {
  id          String                @id @default(uuid()) @db.Uuid
  planId      String                @db.Uuid
  planVersion Int
  kind        PlanningPreviewKind
  status      PlanningPreviewStatus @default(PENDING)
  proposal    Json
  expiresAt   DateTime
  appliedAt   DateTime?
  createdAt   DateTime              @default(now())
  plan        StudyPlan             @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, status, expiresAt])
}

model QuestionAttempt {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @db.Uuid
  questionId          String              @db.Uuid
  sessionId           String?             @db.Uuid
  questionSessionId   String              @db.Uuid
  questionVersionId   String              @db.Uuid
  idempotencyKey      String              @db.VarChar(120)
  selectedOptionIds   String[]            @db.Uuid
  isCorrect           Boolean
  answeredAt          DateTime            @default(now())
  responseTimeMs      Int?
  explanationRevealed Boolean             @default(false)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  question            Question            @relation(fields: [questionId], references: [id], onDelete: Restrict)
  session             StudySession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  questionSession     QuestionSession     @relation(fields: [questionSessionId], references: [id], onDelete: Restrict)
  questionVersion     QuestionVersion     @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  errorNotebookSource ErrorNotebookEntry? @relation("ErrorSourceAttempt")

  @@unique([questionSessionId, questionId])
  @@unique([userId, idempotencyKey])
  @@index([userId, answeredAt])
  @@index([questionId])
}

model ExerciseList {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String?                @db.Uuid
  title       String                 @db.VarChar(180)
  description String?                @db.Text
  mode        ExerciseMode           @default(PRACTICE)
  status      ExerciseListStatus     @default(DRAFT)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User?                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  questions   ExerciseListQuestion[]
  sessions    QuestionSession[]
  tasks       PlanTask[]

  @@index([userId, status, createdAt])
}

model ExerciseListQuestion {
  id             String       @id @default(uuid()) @db.Uuid
  exerciseListId String       @db.Uuid
  questionId     String       @db.Uuid
  position       Int
  exerciseList   ExerciseList @relation(fields: [exerciseListId], references: [id], onDelete: Cascade)
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([exerciseListId, questionId])
  @@unique([exerciseListId, position])
}

model QuestionSession {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @db.Uuid
  exerciseListId  String?               @db.Uuid
  studyTaskId     String?               @db.Uuid
  studySessionId  String?               @db.Uuid
  idempotencyKey  String                @db.VarChar(120)
  status          QuestionSessionStatus @default(IN_PROGRESS)
  mode            ExerciseMode
  startedAt       DateTime              @default(now())
  finishedAt      DateTime?
  totalQuestions  Int
  correctAnswers  Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseList    ExerciseList?         @relation(fields: [exerciseListId], references: [id], onDelete: Restrict)
  studyTask       PlanTask?             @relation(fields: [studyTaskId], references: [id], onDelete: SetNull)
  studySession    StudySession?         @relation(fields: [studySessionId], references: [id], onDelete: SetNull)
  items           QuestionSessionItem[]
  attempts        QuestionAttempt[]
  mockExamAttempt MockExamAttempt?

  @@unique([userId, idempotencyKey])
  @@index([userId, status, startedAt])
}

model QuestionSessionItem {
  id                String           @id @default(uuid()) @db.Uuid
  questionSessionId String           @db.Uuid
  questionId        String           @db.Uuid
  questionVersionId String           @db.Uuid
  position          Int
  mockExamSectionId String?          @db.Uuid
  questionSession   QuestionSession  @relation(fields: [questionSessionId], references: [id], onDelete: Cascade)
  question          Question         @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersion   QuestionVersion  @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  mockExamSection   MockExamSection? @relation(fields: [mockExamSectionId], references: [id], onDelete: Restrict)

  @@unique([questionSessionId, questionId])
  @@unique([questionSessionId, position])
}

model ReviewSchedule {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @db.Uuid
  topicId        String               @db.Uuid
  status         ReviewScheduleStatus @default(ACTIVE)
  nextReviewAt   DateTime
  lastReviewedAt DateTime?
  reviewCount    Int                  @default(0)
  lapseCount     Int                  @default(0)
  stability      Decimal              @default(1) @db.Decimal(10, 3)
  difficulty     Decimal              @default(5) @db.Decimal(5, 2)
  intervalDays   Int                  @default(1)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic          Topic                @relation(fields: [topicId], references: [id], onDelete: Restrict)
  attempts       ReviewAttempt[]
  tasks          PlanTask[]

  @@unique([userId, topicId])
  @@index([userId, status, nextReviewAt])
  @@index([topicId])
}

model ReviewAttempt {
  id                   String         @id @default(uuid()) @db.Uuid
  reviewScheduleId     String         @db.Uuid
  userId               String         @db.Uuid
  rating               ReviewRating
  reviewedAt           DateTime       @default(now())
  previousIntervalDays Int
  nextIntervalDays     Int
  responseTimeSeconds  Int?
  notes                String?        @db.Text
  idempotencyKey       String         @db.VarChar(120)
  createdAt            DateTime       @default(now())
  schedule             ReviewSchedule @relation(fields: [reviewScheduleId], references: [id], onDelete: Restrict)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([reviewScheduleId, reviewedAt])
  @@index([userId, reviewedAt])
}

model ErrorNotebookEntry {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  questionId      String              @db.Uuid
  topicId         String?             @db.Uuid
  sourceAttemptId String?             @unique @db.Uuid
  status          ErrorNotebookStatus @default(OPEN)
  notes           String?             @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question            @relation(fields: [questionId], references: [id], onDelete: Restrict)
  topic           Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sourceAttempt   QuestionAttempt?    @relation("ErrorSourceAttempt", fields: [sourceAttemptId], references: [id], onDelete: SetNull)

  @@unique([userId, questionId])
  @@index([userId, status, updatedAt])
  @@index([userId, topicId])
}

model MockExam {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  title            String            @db.VarChar(180)
  description      String?           @db.Text
  studyGoalId      String?           @db.Uuid
  examinationId    String?           @db.Uuid
  positionId       String?           @db.Uuid
  durationMinutes  Int?
  totalQuestions   Int
  status           MockExamStatus    @default(DRAFT)
  scoringStrategy  ScoringStrategy   @default(SIMPLE)
  selectionSeed    String            @db.VarChar(120)
  selectionFilters Json
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  studyGoal        Objective?        @relation(fields: [studyGoalId], references: [id], onDelete: SetNull)
  examination      Examination?      @relation(fields: [examinationId], references: [id], onDelete: SetNull)
  position         Position?         @relation(fields: [positionId], references: [id], onDelete: SetNull)
  sections         MockExamSection[]
  attempts         MockExamAttempt[]
  tasks            PlanTask[]

  @@index([userId, status, createdAt])
}

model MockExamSection {
  id            String                @id @default(uuid()) @db.Uuid
  mockExamId    String                @db.Uuid
  subjectId     String?               @db.Uuid
  title         String                @db.VarChar(160)
  questionCount Int
  weight        Decimal               @default(1) @db.Decimal(8, 3)
  order         Int
  filters       Json?
  mockExam      MockExam              @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  subject       Subject?              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  sessionItems  QuestionSessionItem[]

  @@unique([mockExamId, order])
  @@index([subjectId])
}

model MockExamAttempt {
  id                String                @id @default(uuid()) @db.Uuid
  mockExamId        String                @db.Uuid
  userId            String                @db.Uuid
  questionSessionId String                @unique @db.Uuid
  status            MockExamAttemptStatus @default(IN_PROGRESS)
  startedAt         DateTime              @default(now())
  deadlineAt        DateTime?
  submittedAt       DateTime?
  finishedAt        DateTime?
  rawScore          Decimal?              @db.Decimal(10, 3)
  weightedScore     Decimal?              @db.Decimal(10, 3)
  correctAnswers    Int?
  totalQuestions    Int
  resultSnapshot    Json?
  createdAt         DateTime              @default(now())
  mockExam          MockExam              @relation(fields: [mockExamId], references: [id], onDelete: Restrict)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  questionSession   QuestionSession       @relation(fields: [questionSessionId], references: [id], onDelete: Restrict)

  @@index([userId, status, startedAt])
  @@index([mockExamId, startedAt])
}
